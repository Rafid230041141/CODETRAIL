<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="620.0" prefWidth="680.0" spacing="14.0" styleClass="quiz-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.client.controller.QuizController">
    <fx:define>
        <ToggleGroup fx:id="answerGroup"/>
    </fx:define>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label fx:id="quizLessonLabel" maxWidth="1.7976931348623157E308" styleClass="quiz-lesson" HBox.hgrow="ALWAYS"/>
                <Label fx:id="quizTimerLabel" alignment="CENTER" minWidth="95.0" styleClass="quiz-timer-badge, quiz-timer-normal" text="⏱ 05:00"/>
            </children>
        </HBox>
        <Separator/>
        <VBox fx:id="questionPane" spacing="13.0" VBox.vgrow="ALWAYS">
            <children>
                <Label fx:id="quizProgressLabel" styleClass="section-eyebrow"/>
                <Label fx:id="questionLabel" wrapText="true" styleClass="quiz-question"/>
                <RadioButton fx:id="optionA" maxWidth="1.7976931348623157E308"
                             toggleGroup="$answerGroup" wrapText="true" styleClass="quiz-option"/>
                <RadioButton fx:id="optionB" maxWidth="1.7976931348623157E308"
                             toggleGroup="$answerGroup" wrapText="true" styleClass="quiz-option"/>
                <RadioButton fx:id="optionC" maxWidth="1.7976931348623157E308"
                             toggleGroup="$answerGroup" wrapText="true" styleClass="quiz-option"/>
                <RadioButton fx:id="optionD" maxWidth="1.7976931348623157E308"
                             toggleGroup="$answerGroup" wrapText="true" styleClass="quiz-option"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Label fx:id="feedbackLabel" minHeight="22.0" wrapText="true" styleClass="auth-error"/>
                <Button fx:id="actionButton" maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false" onAction="#advance" text="Next question"
                        styleClass="primary-button"/>
            </children>
        </VBox>
        <VBox fx:id="resultPane" alignment="CENTER" managed="false" spacing="14.0"
              visible="false" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Quiz Complete" styleClass="quiz-result-title"/>
                <Label fx:id="resultStatusLabel" styleClass="quiz-result-passed"/>
                <Label fx:id="resultScoreLabel" styleClass="quiz-result-score"/>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="260.0" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: #d8e0e3; -fx-border-radius: 6px;">
                    <content>
                        <VBox fx:id="resultFeedbackBox" spacing="8.0" style="-fx-padding: 8px;"/>
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER" spacing="16.0">
                    <children>
                        <Button fx:id="retryButton" mnemonicParsing="false" onAction="#retryQuiz"
                                text="🔄 Try Again" styleClass="secondary-button"/>
                        <Button fx:id="closeButton" mnemonicParsing="false" onAction="#close"
                                text="Return to Lesson" styleClass="primary-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="24.0" left="26.0" right="26.0" top="22.0"/>
    </padding>
</VBox>
