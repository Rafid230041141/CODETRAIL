                                                                    </children>
                                                                </HBox>
                                                                <HBox alignment="CENTER_LEFT" spacing="16.0">
                                                                    <children>
                                                                        <Label minWidth="130.0" text="Account Status:" styleClass="profile-field-name"/>
                                                                        <Label text="Active" styleClass="profile-status-active"/>
                                                                    </children>
                                                                </HBox>
                                                            </children>
