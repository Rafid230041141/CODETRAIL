                                                                <Label fx:id="profileCoursesCountLabel" text="7" styleClass="stat-box-value"/>
                                                                <Label text="Enrolled curriculum tracks" styleClass="stat-box-hint"/>
                                                            </children>
                                                            <padding>
                                                                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                                                            </padding>
                                                        </VBox>
                                                    </children>
                                                </FlowPane>

                                                <VBox spacing="16.0" styleClass="profile-card">
                                                    <children>
                                                        <Label text="Account Information" styleClass="section-title"/>
