                                      styleClass="topic-drawer-pane">
                                    <children>
                                        <!-- Top Thumbnail Image (The Blue Box in user's sketch) -->
                                        <StackPane styleClass="topic-drawer-banner-box">
                                            <children>
                                                 <ImageView fx:id="topicDrawerImage" fitHeight="285.0" fitWidth="500.0"
                                                            preserveRatio="true"/>
