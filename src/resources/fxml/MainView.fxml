<StackPane fx:id="appRoot" prefHeight="900.0" prefWidth="1440.0" styleClass="app-root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="application.client.controller.AppController">
    <children>
        <StackPane fx:id="loginView" styleClass="auth-screen">
            <children>
                <VBox alignment="CENTER" maxWidth="430.0" spacing="15.0" styleClass="auth-panel">
                    <children>
                        <StackPane>
                            <children>
                                <VBox alignment="CENTER" spacing="8.0">
                                    <children>
                                        <StackPane minHeight="106.0" minWidth="106.0" prefHeight="106.0" prefWidth="106.0"
                                                   styleClass="brand-mark">
                                            <children>
                                                <ImageView fitHeight="96.0" fitWidth="96.0" preserveRatio="true">
                                                    <image>
                                                        <Image url="@../images/logo-icon.png"/>
                                                    </image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                        <HBox alignment="CENTER" spacing="0.0">
                                            <children>
                                                <Label fx:id="brandTitleLabel" text="Code" styleClass="brand-title"/>
                                                <Label fx:id="brandTitleAccentLabel" text="Trail" styleClass="brand-title-accent"/>
                                            </children>
                                        </HBox>
                                        <Label fx:id="brandSubtitleLabel" text="LEARNING PLATFORM" styleClass="brand-subtitle"/>
                                    </children>
                                </VBox>
                                <ToggleButton fx:id="loginThemeToggle" mnemonicParsing="false"
                                              onAction="#toggleTheme"
                                              contentDisplay="GRAPHIC_ONLY"
                                              styleClass="theme-toggle"
                                              StackPane.alignment="TOP_RIGHT">
                                    <graphic>
                                        <ImageView fx:id="loginThemeIcon" fitHeight="17.0" fitWidth="17.0"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../images/icon-moon-dark.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </ToggleButton>
                            </children>
                        </StackPane>
                        <Separator/>
                        <Label fx:id="authTitleLabel" text="Welcome back" styleClass="auth-title"/>
                        <Label fx:id="authSubtitleLabel" wrapText="true"
                               text="Sign in to continue learning." styleClass="auth-subtitle"/>
                        <TextField fx:id="displayNameField" managed="false" visible="false"
                                   promptText="Display name" styleClass="form-field"/>
                        <StackPane fx:id="usernameFieldShell" styleClass="field-shell">
                            <children>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true"
                                           styleClass="field-icon" StackPane.alignment="CENTER_LEFT">
                                    <image>
                                        <Image url="@../images/icon-person.png"/>
                                    </image>
                                </ImageView>
                                <TextField fx:id="usernameField" promptText="Username or Gmail address" styleClass="field-input"/>
                            </children>
                        </StackPane>
                        <StackPane fx:id="passwordFieldShell" styleClass="field-shell">
                            <children>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true"
                                           styleClass="field-icon" StackPane.alignment="CENTER_LEFT">
                                    <image>
                                        <Image url="@../images/icon-lock.png"/>
                                    </image>
                                </ImageView>
                                <PasswordField fx:id="passwordField" promptText="Password" styleClass="field-input"/>
                                <TextField fx:id="passwordTextField" managed="false" visible="false"
                                           promptText="Password" styleClass="field-input"/>
                                <ToggleButton fx:id="passwordVisibilityToggle" mnemonicParsing="false"
                                              onAction="#togglePasswordVisibility"
                                              contentDisplay="GRAPHIC_ONLY"
                                              styleClass="eye-toggle" StackPane.alignment="CENTER_RIGHT">
                                    <graphic>
                                        <ImageView fx:id="passwordVisibilityIcon" fitHeight="16.0" fitWidth="16.0"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../images/icon-eye.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </ToggleButton>
                            </children>
                        </StackPane>
                        <HBox fx:id="forgotPasswordRow" alignment="CENTER_RIGHT">
                            <children>
                                <Button fx:id="forgotPasswordButton" mnemonicParsing="false"
                                        onAction="#showForgotPasswordDialog" text="Forgot password?"
                                        styleClass="forgot-password-link"/>
                            </children>
                        </HBox>
                        <ComboBox fx:id="roleSelector" managed="false" visible="false"
                                  maxWidth="1.7976931348623157E308" promptText="Role" styleClass="form-field"/>
                        <Label fx:id="authMessageLabel" minHeight="22.0" wrapText="true"
                               styleClass="auth-error"/>
                        <Button fx:id="authPrimaryButton" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#submitAuth" text="Sign in"
                                styleClass="primary-button"/>
                        <HBox alignment="CENTER" spacing="10.0" styleClass="auth-divider-row">
                            <children>
                                <Separator HBox.hgrow="ALWAYS"/>
                                <Label text="OR" styleClass="auth-divider-text"/>
                                <Separator HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                        <Button fx:id="googleAuthButton" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#handleGoogleAuth"
                                styleClass="google-auth-button">
                            <graphic>
                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                            <image>
                                                <Image url="@../images/icon-google.png"/>
                                            </image>
                                        </ImageView>
                                        <Label fx:id="googleAuthLabel" text="Continue with Google" styleClass="google-auth-text"/>
                                    </children>
                                </HBox>
                            </graphic>
                        </Button>
                        <Button fx:id="authModeButton" maxWidth="1.7976931348623157E308"
                                mnemonicParsing="false" onAction="#toggleAuthMode"
                                text="New here? Create account" styleClass="text-button"/>
                        <Label text="Demo: student / student123 or admin / admin123"
                               wrapText="true" styleClass="auth-hint"/>
                    </children>
                    <padding>
                        <Insets bottom="28.0" left="30.0" right="30.0" top="28.0"/>
                    </padding>
                </VBox>
            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
            </padding>
        </StackPane>

        <StackPane fx:id="studentView" managed="false" visible="false">
            <children>
                <BorderPane>
                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="app-toolbar">
                            <children>
                                <StackPane minHeight="36.0" minWidth="36.0" prefHeight="36.0" prefWidth="36.0"
                                           styleClass="brand-mark">
                                    <children>
                                        <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                                            <image>
                                                <Image url="@../images/logo-icon.png"/>
                                            </image>
                                        </ImageView>
                                    </children>
                                </StackPane>
                                <HBox alignment="CENTER_LEFT" spacing="0.0">
                                    <children>
                                        <Label text="Code" styleClass="toolbar-title"/>
                                        <Label text="Trail" styleClass="brand-title-accent"/>
                                    </children>
                                </HBox>
                                <Label text="STUDENT" styleClass="role-badge"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="studentProfileButton" mnemonicParsing="false"
                                        onAction="#showProfile" styleClass="toolbar-profile-button">
                                    <graphic>
                                        <HBox alignment="CENTER" spacing="8.0">
                                            <children>
                                                <ImageView fx:id="studentProfileIcon" fitHeight="26.0" fitWidth="26.0" preserveRatio="true">
                                                    <image>
                                                        <Image url="@../images/icon-user-account.png"/>
                                                    </image>
                                                </ImageView>
                                                <Label fx:id="studentNameLabel" styleClass="toolbar-user"/>
                                            </children>
                                        </HBox>
                                    </graphic>
                                </Button>
                                <ToggleButton fx:id="studentThemeToggle" mnemonicParsing="false"
                                              onAction="#toggleTheme"
                                              contentDisplay="GRAPHIC_ONLY"
                                              styleClass="theme-toggle">
                                    <graphic>
                                        <ImageView fx:id="studentThemeIcon" fitHeight="17.0" fitWidth="17.0"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../images/icon-moon-dark.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </ToggleButton>
                                <Button fx:id="studentLogoutButton" mnemonicParsing="false"
                                        onAction="#logout" text="Sign out"
                                        styleClass="secondary-button"/>
                            </children>
                            <padding>
                                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0"/>
                            </padding>
                        </HBox>
                    </top>
                    <left>
                        <VBox prefWidth="310.0" spacing="10.0" styleClass="curriculum-sidebar">
                            <children>
                                <Label text="CURRICULUM" styleClass="section-eyebrow"/>
                                <HBox spacing="6.0">
                                    <children>
                                        <Button fx:id="sidebarDashboardBtn" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"
                                                mnemonicParsing="false" onAction="#showDashboard"
                                                text="Dashboard" styleClass="sidebar-action"/>
                                        <Button fx:id="sidebarProfileBtn" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"
                                                mnemonicParsing="false" onAction="#showProfile"
                                                text="Profile" styleClass="sidebar-action-secondary"/>
                                    </children>
                                </HBox>
                                <VBox fx:id="continueSidebarSection" spacing="8.0" styleClass="continue-sidebar-box">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="CONTINUE LEARNING" styleClass="continue-sidebar-header"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="continueTrackLabel" text="Languages" styleClass="continue-course-title"/>
                                            </children>
                                        </HBox>
                                        <VBox fx:id="continueItemsBox" spacing="6.0"/>
                                    </children>
                                </VBox>
                                <TreeView fx:id="curriculumTree" VBox.vgrow="ALWAYS"
                                          styleClass="topic-tree"/>
                                <Label fx:id="studentStatusLabel" wrapText="true"
                                       styleClass="sidebar-status"/>
                            </children>
                            <padding>
                                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
                            </padding>
                        </VBox>
                    </left>
                    <center>
                        <StackPane fx:id="studentContent" styleClass="content-stack">
                            <children>
                                <ScrollPane fx:id="dashboardPane" fitToWidth="true" hbarPolicy="NEVER"
                                            styleClass="content-scroll">
                                    <content>
                                        <VBox maxWidth="1.7976931348623157E308" spacing="24.0" styleClass="page-content">
                                            <children>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="STUDENT HOME" styleClass="section-eyebrow"/>
                                                        <Label text="Continue learning" styleClass="page-title"/>
                                                         <Label text="Choose a course to begin learning: Languages, DSA, Web Dev, App Dev, AI/ML, Data Science, and Game Dev."
                                                               wrapText="true" styleClass="page-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <FlowPane fx:id="topicCards" hgap="18.0" vgap="18.0"/>
                                                <VBox spacing="16.0" styleClass="progress-section">
                                                    <children>
                                                        <Label text="Overall progress" styleClass="section-title"/>
                                                        <HBox fx:id="overallProgressRow" alignment="CENTER_LEFT" spacing="24.0">
                                                            <children>
                                                                <StackPane fx:id="overallProgressChart"/>
                                                                <VBox spacing="6.0">
                                                                    <children>
                                                                        <Label fx:id="dashboardProgressLabel"
                                                                               text="Loading progress..."
                                                                               styleClass="progress-caption" wrapText="true"/>
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <Separator/>
                                                        <Label text="Progress by topic" styleClass="section-title"/>
                                                        <FlowPane fx:id="topicProgressBox" hgap="20.0" vgap="16.0"/>
                                                    </children>
                                                    <padding>
                                                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/>
                                                    </padding>
                                                </VBox>
                                            </children>
                                            <padding>
                                                <Insets bottom="42.0" left="38.0" right="38.0" top="36.0"/>
                                            </padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <ScrollPane fx:id="lessonPane" fitToWidth="true" hbarPolicy="NEVER"
                                            managed="false" visible="false" styleClass="content-scroll">
                                    <content>
                                        <VBox maxWidth="1.7976931348623157E308" spacing="22.0" styleClass="page-content">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="lesson-nav-bar">
                                                    <children>
                                                        <Label fx:id="lessonPathLabel" wrapText="true"
                                                               styleClass="section-eyebrow" HBox.hgrow="ALWAYS"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Button fx:id="lessonBackBtn" mnemonicParsing="false" onAction="#navigateBackFromLesson"
                                                                styleClass="top-right-back-btn">
                                                            <graphic>
                                                                <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                                                                    <image>
                                                                        <Image url="@../images/icon-back-arrow.png"/>
                                                                    </image>
                                                                </ImageView>
                                                            </graphic>
                                                            <tooltip>
                                                                <Tooltip text="Back to Dashboard"/>
                                                            </tooltip>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lessonTitleLabel" wrapText="true"
                                                       styleClass="page-title"/>
                                                <Label fx:id="lessonSummaryLabel" wrapText="true"
                                                       styleClass="lesson-summary"/>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <CheckBox fx:id="lessonCompletedCheckBox"
                                                                  text="Mark lesson complete"
                                                                  styleClass="completion-check"/>
                                                         <Region HBox.hgrow="ALWAYS"/>
                                                         <Button fx:id="lessonWatchVideoBtn" mnemonicParsing="false"
                                                                 managed="false" visible="false"/>
                                                         <Button fx:id="lessonCopyVideoBtn" mnemonicParsing="false"
                                                                 managed="false" visible="false"/>
                                                         <Button fx:id="quizButton" mnemonicParsing="false"
                                                                 onAction="#openQuiz" text="Take quiz"
                                                                 styleClass="primary-button"/>
                                                    </children>
                                                </HBox>
                                                <Separator/>
                                                <VBox fx:id="lessonVideoContainer" managed="false" visible="false" spacing="10.0" maxWidth="960.0" styleClass="lesson-embedded-video-box">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="lesson-embedded-video-header">
                                                            <children>
                                                                <Label text="🎥 Video Lecture" styleClass="lesson-video-header-tag" minWidth="-Infinity"/>
                                                                <Label fx:id="lessonVideoTitleLabel" text="Video Lecture" styleClass="lesson-video-title" wrapText="true" HBox.hgrow="ALWAYS"/>
                                                                <Button fx:id="lessonVideoPlayBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#startLessonVideo" text="▶ Play Video" styleClass="lesson-video-action-play"/>
                                                                <Button fx:id="lessonVideoStopBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#stopLessonVideo" text="■ Stop Video" managed="false" visible="false" styleClass="lesson-video-action-stop"/>
                                                                <Button fx:id="lessonVideoRewindBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#seekLessonVideoBackward" text="⏪ -10s" managed="false" visible="false" styleClass="lesson-video-action-skip"/>
                                                                <Button fx:id="lessonVideoForwardBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#seekLessonVideoForward" text="+10s ⏩" managed="false" visible="false" styleClass="lesson-video-action-skip"/>
                                                                <Button fx:id="openCurrentLessonVideo" minWidth="-Infinity" mnemonicParsing="false" onAction="#openCurrentLessonVideo" text="Browser ↗" styleClass="lesson-video-action-browser"/>
                                                                <Button fx:id="lessonVideoCopyLinkBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#copyCurrentLessonVideo" text="📋 Copy" styleClass="lesson-video-action-copy"/>
                                                            </children>
                                                        </HBox>
                                                        <StackPane fx:id="embeddedWebPlayerPane" alignment="CENTER" maxWidth="960.0" prefWidth="860.0" prefHeight="484.0" styleClass="embedded-player-frame">
                                                            <children>
                                                                <ImageView fx:id="lessonVideoPoster" fitWidth="860.0" fitHeight="484.0" preserveRatio="true" styleClass="lesson-video-poster"/>
                                                                <Region fx:id="lessonPosterOverlay" styleClass="lesson-video-poster-overlay" mouseTransparent="true"/>
                                                                <VBox fx:id="lessonPlayPromptBox" alignment="CENTER" spacing="10.0" mouseTransparent="true">
                                                                    <children>
                                                                        <StackPane fx:id="lessonPlayCircleBtn" styleClass="lesson-video-play-circle">
                                                                            <children>
                                                                                <Label text="▶" styleClass="lesson-video-play-glyph"/>
                                                                            </children>
                                                                        </StackPane>
                                                                        <Label text="Click to Play Embedded Video (Cloud Streamed)" styleClass="lesson-video-play-prompt"/>
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </StackPane>
                                                    </children>
                                                </VBox>
                                                <VBox fx:id="simulationSection" spacing="10.0">
                                                    <children>
                                                        <Label text="Interactive simulation"
                                                               styleClass="section-title"/>
                                                        <fx:include fx:id="simulationContent"
                                                                    source="SimulationView.fxml"/>
                                                    </children>
                                                </VBox>
                                                <VBox fx:id="markdownContent" spacing="16.0"/>
                                                <VBox spacing="12.0" styleClass="lesson-playground-wrapper">
                                                    <children>
                                                        <Label text="Interactive Hands-On Example" styleClass="section-title"/>
                                                        <VBox fx:id="examplePlaygroundSection" spacing="14.0" styleClass="lesson-playground-card">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="playground-header">
                                                                    <children>
                                                                        <Label text="💻 Hands-On Code Playground" styleClass="playground-title"/>
                                                                        <Label fx:id="playgroundLangBadge" text="Python 3" styleClass="playground-lang-badge"/>
                                                                        <Region HBox.hgrow="ALWAYS"/>
                                                                        <Button fx:id="playgroundRunBtn" mnemonicParsing="false" onAction="#runPlaygroundCode"
                                                                                text="▶ Run Code" styleClass="playground-run-btn"/>
                                                                        <Button fx:id="playgroundResetBtn" mnemonicParsing="false" onAction="#resetPlaygroundCode"
                                                                                text="↺ Reset" styleClass="playground-tool-btn"/>
                                                                        <Button fx:id="playgroundCopyBtn" mnemonicParsing="false" onAction="#copyPlaygroundCode"
                                                                                text="📋 Copy" styleClass="playground-tool-btn"/>
                                                                        <Button fx:id="playgroundArenaBtn" mnemonicParsing="false" onAction="#openPlaygroundInArena"
                                                                                text="⚡ Open in Full Arena ↗" styleClass="playground-arena-btn"/>
                                                                    </children>
                                                                    <padding>
                                                                        <Insets bottom="12.0" left="16.0" right="16.0" top="12.0"/>
                                                                    </padding>
                                                                </HBox>

                                                                <VBox fx:id="playgroundEditorHost" spacing="0.0" VBox.vgrow="ALWAYS" styleClass="playground-ide-host">
                                                                    <children>
                                                                        <StackPane fx:id="playgroundEditorContainer" minHeight="420.0" VBox.vgrow="ALWAYS"/>
                                                                        <TextArea fx:id="lessonExampleArea" visible="false" managed="false" maxHeight="0.0" maxWidth="0.0" prefHeight="0.0" prefWidth="0.0" minHeight="0.0" minWidth="0.0"/>
                                                                    </children>
                                                                    <padding>
                                                                        <Insets bottom="4.0" left="14.0" right="14.0" top="2.0"/>
                                                                    </padding>
                                                                </VBox>

                                                                <VBox fx:id="playgroundConsoleBox" spacing="8.0" styleClass="playground-console">
                                                                    <children>
                                                                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="console-header-bar">
                                                                            <children>
                                                                                <Label text="TERMINAL OUTPUT" styleClass="console-title"/>
                                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                                <Label fx:id="playgroundStatusLabel" text="Ready to execute" styleClass="console-status-tag"/>
                                                                                <Button fx:id="clearConsoleBtn" mnemonicParsing="false" onAction="#clearPlaygroundConsole"
                                                                                        text="Clear" styleClass="console-clear-btn"/>
                                                                            </children>
                                                                        </HBox>
                                                                        <TextArea fx:id="playgroundConsoleArea" editable="false" prefRowCount="8" minHeight="140.0"
                                                                                  wrapText="true" styleClass="console-output-text"/>
                                                                    </children>
                                                                    <padding>
                                                                        <Insets bottom="14.0" left="14.0" right="14.0" top="10.0"/>
                                                                    </padding>
                                                                </VBox>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                            <padding>
                                                <Insets bottom="52.0" left="42.0" right="42.0" top="36.0"/>
                                            </padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <ScrollPane fx:id="profilePane" fitToWidth="true" hbarPolicy="NEVER"
                                            managed="false" visible="false" styleClass="content-scroll">
                                    <content>
                                        <VBox maxWidth="1.7976931348623157E308" spacing="24.0" styleClass="page-content">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="profile-header-card">
                                                    <children>
                                                         <VBox alignment="CENTER" spacing="6.0">
                                                             <children>
                                                                 <StackPane fx:id="profileAvatarContainer" minHeight="76.0" minWidth="76.0" prefHeight="76.0" prefWidth="76.0"
                                                                            styleClass="profile-avatar-large" onMouseClicked="#attachStudentAvatar" style="-fx-cursor: hand;">
                                                                     <children>
                                                                         <ImageView fx:id="profileAvatarIcon" fitHeight="70.0" fitWidth="70.0" preserveRatio="true">
                                                                             <image>
                                                                                 <Image url="@../images/icon-user-account.png"/>
                                                                             </image>
                                                                         </ImageView>
                                                                     </children>
                                                                 </StackPane>
                                                                 <Button fx:id="attachAvatarBtn" mnemonicParsing="false" onAction="#attachStudentAvatar"
                                                                         text="Attach Photo" styleClass="secondary-button"
                                                                         style="-fx-font-size: 11px; -fx-padding: 3px 8px; -fx-cursor: hand;">
                                                                     <graphic>
                                                                         <ImageView fx:id="attachAvatarBtnIcon" fitHeight="13.0" fitWidth="13.0" preserveRatio="true">
                                                                             <image>
                                                                                 <Image url="@../images/icon-photo.png"/>
                                                                             </image>
                                                                         </ImageView>
                                                                     </graphic>
                                                                 </Button>
                                                             </children>
                                                         </VBox>
                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                                    <children>
                                                                        <Label fx:id="profileDisplayNameLabel" text="Student Name" styleClass="profile-name-title"/>
                                                                        <Label text="STUDENT" styleClass="role-badge"/>
                                                                    </children>
                                                                </HBox>
                                                                <Label fx:id="profileUsernameLabel" text="@student" styleClass="profile-username-subtitle"/>
