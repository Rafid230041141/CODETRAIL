                                                                     <graphic>
                                                                         <ImageView fx:id="topicDrawerCompilerIcon" fitHeight="13.0" fitWidth="13.0" preserveRatio="true">
                                                                             <image>
                                                                                 <Image url="@../images/icon-compiler.png"/>
                                                                             </image>
                                                                         </ImageView>
                                                                     </graphic>
                                                                     <tooltip>
                                                                         <Tooltip text="Open Exercise Compiler for this course"/>
                                                                     </tooltip>
                                                                 </Label>
                                                            </children>
                                                        </HBox>

                                                        <VBox spacing="8.0">
