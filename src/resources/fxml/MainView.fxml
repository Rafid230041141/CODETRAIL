                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="16.0">
                                                                    <children>
                                                                        <Label minWidth="130.0" text="Display Name:" styleClass="profile-field-name"/>
                                                                        <Label fx:id="profileDetailDisplayName" text="Student" styleClass="profile-field-value"/>
                                                                    </children>
                                                                </HBox>
                                                                <HBox alignment="CENTER_LEFT" spacing="16.0">
                                                                    <children>
                                                                        <Label minWidth="130.0" text="Username:" styleClass="profile-field-name"/>
