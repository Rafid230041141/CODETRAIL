                                                                         <ImageView fx:id="topicDrawerLessonsIcon" fitHeight="13.0" fitWidth="13.0" preserveRatio="true">
                                                                             <image>
                                                                                 <Image url="@../images/icon-lesson.png"/>
                                                                             </image>
                                                                         </ImageView>
                                                                     </graphic>
                                                                 </Label>
                                                                 <Label fx:id="topicDrawerModulesBadge" text="0 Modules"
                                                                        styleClass="topic-drawer-badge-secondary">
                                                                     <graphic>
                                                                         <ImageView fx:id="topicDrawerModulesIcon" fitHeight="13.0" fitWidth="13.0" preserveRatio="true">
                                                                             <image>
                                                                                 <Image url="@../images/icon-module.png"/>
                                                                             </image>
                                                                         </ImageView>
                                                                     </graphic>
                                                                 </Label>
                                                                 <Label fx:id="topicDrawerCompilerBadge" text="Exercise Compiler"
                                                                        styleClass="topic-drawer-badge-compiler"
