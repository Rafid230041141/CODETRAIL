                                                                       wrapText="true" styleClass="topic-drawer-body-text"/>
                                                            </children>
                                                        </VBox>

                                                        <Separator/>

                                                        <VBox spacing="8.0">
                                                            <children>
                                                                <Label text="Why This Matters in the Real World"
                                                                       styleClass="topic-drawer-section-heading"/>
                                                                <Label fx:id="topicDrawerRealWorld" text="Real-world engineering impact..."
                                                                       wrapText="true" styleClass="topic-drawer-body-text"/>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </ScrollPane>

                                        <!-- Sticky Bottom Bar with Start Learning and Exercise Compiler Buttons -->
                                        <VBox styleClass="topic-drawer-footer">
                                            <children>
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <Button fx:id="topicDrawerStartButton" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                                                mnemonicParsing="false" onAction="#handleTopicDrawerStart"
                                                                text="Start learning" styleClass="topic-drawer-start-btn"/>
                                                        <Button fx:id="topicDrawerCompilerButton" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                                                mnemonicParsing="false" onAction="#handleDrawerCompilerClicked"
                                                                text="Exercise Compiler" styleClass="topic-drawer-compiler-btn"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </center>
                </BorderPane>
