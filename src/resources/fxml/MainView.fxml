                                                        <Insets right="14.0" top="14.0"/>
                                                    </StackPane.margin>
                                                </Button>
                                            </children>
                                        </StackPane>

                                        <!-- Content Details (The Dark Box in user's sketch) -->
                                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                                                    styleClass="topic-drawer-scroll">
                                            <content>
                                                <VBox spacing="18.0" styleClass="topic-drawer-content">
                                                    <children>
                                                        <VBox spacing="6.0">
                                                            <children>
                                                                <Label text="COURSE OVERVIEW" styleClass="topic-drawer-eyebrow"/>
