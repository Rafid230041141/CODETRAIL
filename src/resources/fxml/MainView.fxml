                                                            </children>
                                                            <padding>
                                                                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                                                            </padding>
                                                        </VBox>
                                                        <VBox prefWidth="220.0" spacing="6.0" styleClass="profile-stat-box">
                                                            <children>
                                                                <Label text="QUIZ ATTEMPTS" styleClass="stat-box-title"/>
